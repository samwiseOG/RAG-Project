# RAG Project Environment Configuration
# Copy this file to .env and update values as needed

# ========== Qdrant Vector Database ==========
# URL for Qdrant vector database
QDRANT_URL=http://localhost:6333

# Default collection name for storing vectors
DEFAULT_COLLECTION_NAME=RAG-Project-Langchain

# Embedding vector size (must match the embedding model output dimension)
# nomic-embed-text outputs 768 dimensions
VECTOR_SIZE=768

# Vector similarity metric: DOT, COSINE, or EUCLID
DISTANCE_METRIC=DOT

# ========== Ollama LLM Configuration ==========
# Ollama server host (inside Docker: localhost, outside: container IP or hostname)
OLLAMA_HOST=localhost:11434

# Embedding model to use (must be available in Ollama)
# Options: nomic-embed-text (768 dims), all-minilm:l6-v2 (384 dims), etc.
EMBEDDING_MODEL=nomic-embed-text

# LLM model to use for chat and generation
# Options: deepseek-r1:1.5b, mistral, llama2, neural-chat, etc.
LLM_MODEL=deepseek-r1:1.5b

# ========== Flask API Server ==========
# Flask server host (inside Docker, bind to 0.0.0.0)
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=False

# ========== Streamlit UI Configuration ==========
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# ========== Application Configuration ==========
# Upload folder for PDF documents
UPLOAD_FOLDER=data

# Maximum file upload size (in bytes, 100MB = 104857600)
MAX_UPLOAD_SIZE=104857600

# Number of context chunks to retrieve for RAG
TOP_K_RESULTS=3

# ========== Logging Configuration ==========
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# ========== Docker Volumes ==========
# These paths are used internally in Docker
# QDRANT_STORAGE=/qdrant_storage
# OLLAMA_HOME=/home/appuser/.ollama
# APP_DATA=/app/data
